# ==============================================================================
# Personal Assistant — Environment Configuration Template
# Copy this file to `.env` and fill in your own values.
# NEVER commit `.env` to version control.
# ==============================================================================

# --- Telegram Bot ---
# Token obtained from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated list of authorized Telegram numeric user IDs (e.g. 123456789,987654321)
# You can find your ID using @userinfobot on Telegram
TELEGRAM_ALLOWED_USER_IDS=123456789

# --- LLM Provider (Default: Gemini Free Tier) ---
# Supported providers: gemini | anthropic | openai_compatible
LLM_PROVIDER=gemini

# API key for the selected provider (e.g. Google AI Studio, Anthropic, OpenRouter, Groq)
# Leave empty only when using a local unauthenticated server like Ollama
LLM_API_KEY=your_llm_api_key_here

# Model identifier for the selected provider
LLM_MODEL=gemini-2.5-flash

# Optional custom base URL (required for OpenRouter, Groq, Ollama, vLLM, etc.)
# Examples: https://openrouter.ai/api/v1 | https://api.groq.com/openai/v1 | http://localhost:11434/v1
LLM_BASE_URL=

# --- Speech-to-Text (Audio Fallback for non-audio LLMs like Claude/Ollama) ---
# Options: auto | groq | openai | none
# When set to `auto`, Gemini uses native audio and other providers use STT if STT_API_KEY is set
STT_PROVIDER=auto
STT_API_KEY=

# --- Google Ecosystem (OAuth 2.0) ---
# Paths inside the container (or local paths when running outside Docker)
GOOGLE_CREDENTIALS_PATH=/app/credentials/credentials.json
GOOGLE_TOKEN_PATH=/app/credentials/token.json

# Google Sheets IDs (leave empty before running the setup script)
GOOGLE_SHEETS_CAR_ID=
GOOGLE_SHEETS_BUDGET_ID=

# --- Scheduler & Localization ---
# IANA timezone (e.g. America/Sao_Paulo, UTC, America/New_York)
# Also used by docker-compose.yml to set the container's TZ environment variable
TIMEZONE=America/Sao_Paulo

# Daily morning summary time in 24h HH:MM format
MORNING_SUMMARY_TIME=07:30

# --- Storage, Governance & Logging ---
DATABASE_PATH=/app/data/assistant.db
# Days to keep local action history, short-term chat context, and notification logs
DATA_RETENTION_DAYS=30
LOG_LEVEL=INFO
