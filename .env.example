# ==============================================================================
# Personal Assistant — Environment Configuration Template
# Copy this file to `.env` and fill in your own values.
# NEVER commit `.env` to version control.
# ==============================================================================

# --- Telegram Bot ---
# Token obtained from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated list of authorized Telegram numeric user IDs (e.g. 123456789,987654321)
# You can find your ID using @userinfobot on Telegram
TELEGRAM_ALLOWED_USER_IDS=123456789

# --- Gemini AI ---
# API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use (multimodal with tool calling support)
GEMINI_MODEL=gemini-2.5-flash

# --- Google Ecosystem (OAuth 2.0) ---
# Paths inside the container (or local paths when running outside Docker)
GOOGLE_CREDENTIALS_PATH=/app/credentials/credentials.json
GOOGLE_TOKEN_PATH=/app/credentials/token.json

# Google Sheets IDs (leave empty before running the setup script)
GOOGLE_SHEETS_CAR_ID=
GOOGLE_SHEETS_BUDGET_ID=

# --- Scheduler & Localization ---
# IANA timezone (e.g. America/Sao_Paulo, UTC, America/New_York)
# Also used by docker-compose.yml to set the container's TZ environment variable
TIMEZONE=America/Sao_Paulo

# Daily morning summary time in 24h HH:MM format
MORNING_SUMMARY_TIME=07:30

# --- Storage & Logging ---
DATABASE_PATH=/app/data/assistant.db
LOG_LEVEL=INFO
